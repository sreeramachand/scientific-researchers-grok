# Copy to `.env` in this directory (and/or `frontend/.env` + `backend/.env`).
# Never commit real secrets.

# --- Frontend (Astro exposes only PUBLIC_* to the browser) ---
PUBLIC_WEB3FORMS_ACCESS_KEY=
PUBLIC_SNIPCART_API_KEY=
PUBLIC_BUYMEACOFFEE_URL=https://www.buymeacoffee.com/your-page
PUBLIC_NEON_AUTH_URL=
PUBLIC_API_URL=http://127.0.0.1:8007

# --- Neon Auth (Managed Better Auth) ---
# Auth URL from Neon Console → Branch → Auth → Configuration.
# Browser apps can use the same value as PUBLIC_NEON_AUTH_URL.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Google OAuth is configured in the Neon Console for production.
# Authorized redirect URI must be: {NEON_AUTH_BASE_URL}/callback/google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Django / Neon Postgres ---
# Leave empty to use SQLite at backend/db.sqlite3
DATABASE_URL=
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://127.0.0.1:43147,http://localhost:43147
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:43147,http://localhost:43147
BEHIND_PROXY=false
# Snipcart secret API key for server-side order verification.
# This is not the public key. Leave it empty in git and set it only on the server.
SNIPCART_API_KEY=
