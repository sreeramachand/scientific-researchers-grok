---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Account" description="Manage your Scientific Researchers username, password, email, billing, and subscriptions.">
  <section id="account-app" class="mx-auto hidden max-w-4xl px-4 py-10 lg:px-6">
    <h1 class="font-serif text-4xl">Account</h1>
    <p class="mt-2 text-slate-600">Update your profile, password, email, billing, and subscriptions.</p>

    <div class="mt-8 grid gap-6">
      <form id="profile-form" class="card grid gap-4 p-6">
        <h2 class="font-serif text-2xl">Username and profile</h2>
        <div class="field">
          <label for="name">Display name</label>
          <input id="name" name="name" required />
        </div>
        <div class="field">
          <label for="username">Username</label>
          <input id="username" name="username" required />
        </div>
        <button class="btn btn-primary w-fit" type="submit">Save profile</button>
        <p class="form-note text-sm text-slate-500" data-for="profile-form"></p>
      </form>

      <section class="card grid gap-4 p-6">
        <h2 class="font-serif text-2xl">Password</h2>
        <p id="password-google" class="hidden text-sm text-slate-600">You sign in with Google, so this account does not have a password to change.</p>
        <form id="password-form" class="grid gap-4">
          <p class="text-sm text-slate-600">Enter your current password to set a new one.</p>
          <div class="field">
            <label for="currentPassword">Current password</label>
            <input id="currentPassword" name="currentPassword" type="password" autocomplete="current-password" required />
          </div>
          <div class="field">
            <label for="newPassword">New password</label>
            <input id="newPassword" name="newPassword" type="password" autocomplete="new-password" required minlength="8" />
          </div>
          <button class="btn btn-secondary w-fit" type="submit">Change password</button>
          <p class="form-note text-sm text-slate-500" data-for="password-form"></p>
        </form>
      </section>

      <form id="email-form" class="card grid gap-4 p-6">
        <h2 class="font-serif text-2xl">Email</h2>
        <div class="field">
          <label for="current-email">Current email</label>
          <input id="current-email" readonly />
        </div>
        <div class="field">
          <label for="newEmail">Change email</label>
          <input id="newEmail" name="newEmail" type="email" required />
        </div>
        <button class="btn btn-secondary w-fit" type="submit">Change email</button>
        <p class="form-note text-sm text-slate-500" data-for="email-form"></p>
      </form>

      <section class="card grid gap-4 p-6">
        <h2 class="font-serif text-2xl">Billing</h2>
        <p class="text-sm text-slate-600">Paper purchases are charged at checkout to the email on this account.</p>
        <div class="grid gap-3 sm:grid-cols-2">
          <div class="rounded-xl border border-slate-200 p-4">
            <p class="text-xs font-bold uppercase tracking-wide text-slate-500">Payment method</p>
            <p id="billing-method" class="mt-2 text-slate-800">No card on file</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-4">
            <p class="text-xs font-bold uppercase tracking-wide text-slate-500">Billing email</p>
            <p id="billing-email" class="mt-2 text-slate-800">—</p>
          </div>
        </div>
        <div class="flex flex-wrap gap-3">
          <a class="btn btn-secondary" href="/contact">Billing question</a>
          <a class="btn btn-ghost" href="/#pricing">View plans</a>
        </div>
      </section>

      <section class="card grid gap-4 p-6">
        <h2 class="font-serif text-2xl">Subscriptions</h2>
        <div id="subscription-box" class="rounded-xl border border-slate-200 p-4 text-sm text-slate-700"></div>
        <div class="flex flex-wrap gap-3">
          <a class="btn btn-primary" href="/#pricing">Change plan</a>
          <button id="cancel-sub" class="btn btn-secondary" type="button">Cancel subscription</button>
        </div>
      </section>

      <section class="card grid gap-4 p-6">
        <h2 class="font-serif text-2xl">Purchased papers</h2>
        <ul id="purchase-list" class="space-y-2 text-sm text-slate-700"></ul>
      </section>
    </div>
  </section>
</BaseLayout>

<script>
  import { canChangePassword, changeEmail, changePassword, getSession, requireAuth, updateProfile } from "../lib/auth";
  import { cancelSubscription, getSubscription, listEntitlements } from "../lib/entitlements";

  const initialUser = requireAuth();
  if (!initialUser) throw new Error("redirecting");
  const user = (await getSession()) ?? initialUser;

  document.getElementById("account-app")?.classList.remove("hidden");
  const name = document.getElementById("name") as HTMLInputElement;
  const username = document.getElementById("username") as HTMLInputElement;
  const currentEmail = document.getElementById("current-email") as HTMLInputElement;
  const newEmail = document.getElementById("newEmail") as HTMLInputElement;
  const billingEmail = document.getElementById("billing-email");
  const saved = { name: user.name, username: user.username, email: user.email };
  name.value = saved.name;
  username.value = saved.username;
  currentEmail.value = saved.email;
  newEmail.value = saved.email;
  if (billingEmail) billingEmail.textContent = saved.email;

  function note(id: string, text: string, isError = false) {
    const el = document.querySelector(`[data-for="${id}"]`);
    if (!(el instanceof HTMLElement)) return;
    el.textContent = text;
    el.classList.toggle("text-red-600", isError);
    el.classList.toggle("text-slate-500", !isError);
  }

  function renderCommerce() {
    const sub = getSubscription();
    const box = document.getElementById("subscription-box");
    if (box) {
      box.textContent = sub
        ? `${sub.name} · ${sub.status} · ${sub.interval} · renews ${new Date(sub.renewsOn).toLocaleDateString()}`
        : "No active subscription. Individual paper purchases still appear below.";
    }
    const list = document.getElementById("purchase-list");
    const items = listEntitlements();
    if (list) {
      list.innerHTML = items.length
        ? items.map((item) => `<li>${item.title} · ${new Date(item.purchasedAt).toLocaleDateString()}</li>`).join("")
        : "<li>No paper purchases yet.</li>";
    }
    const method = document.getElementById("billing-method");
    if (method) method.textContent = items.length ? "Charged at checkout" : "No card on file";
  }

  document.getElementById("profile-form")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    try {
      const next = await updateProfile({ name: name.value, username: username.value });
      saved.name = next.name;
      saved.username = next.username;
      name.value = next.name;
      username.value = next.username;
      note("profile-form", "Profile saved.");
    } catch (err) {
      name.value = saved.name;
      username.value = saved.username;
      note("profile-form", err instanceof Error ? err.message : "Could not update profile.", true);
    }
  });

  document.getElementById("password-form")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const data = new FormData(event.target as HTMLFormElement);
    try {
      await changePassword({
        currentPassword: String(data.get("currentPassword") ?? ""),
        newPassword: String(data.get("newPassword") ?? ""),
      });
      note("password-form", "Password updated.");
      (event.target as HTMLFormElement).reset();
    } catch (err) {
      note("password-form", err instanceof Error ? err.message : "Could not update password.", true);
    }
  });

  document.getElementById("email-form")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    try {
      const next = await changeEmail(newEmail.value);
      saved.email = next.email;
      currentEmail.value = next.email;
      newEmail.value = next.email;
      if (billingEmail) billingEmail.textContent = next.email;
      note("email-form", "Email updated.");
    } catch (err) {
      newEmail.value = saved.email;
      currentEmail.value = saved.email;
      if (billingEmail) billingEmail.textContent = saved.email;
      note("email-form", err instanceof Error ? err.message : "Could not update email.", true);
    }
  });

  document.getElementById("cancel-sub")?.addEventListener("click", () => {
    cancelSubscription();
    renderCommerce();
  });

  const passwordAllowed = await canChangePassword();
  document.getElementById("password-form")?.classList.toggle("hidden", !passwordAllowed);
  document.getElementById("password-google")?.classList.toggle("hidden", passwordAllowed);

  renderCommerce();
  window.addEventListener("sr-entitlements-changed", renderCommerce);
</script>
