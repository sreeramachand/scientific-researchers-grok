---
import BaseLayout from "../layouts/BaseLayout.astro";
import PricingCards from "../components/PricingCards.astro";
import { awards } from "../data/awards";
import { categoryMeta, papers } from "../data/papers";
import { site } from "../data/site";
---

<BaseLayout title={site.name} description={site.description}>
  <section class="relative overflow-hidden border-b border-slate-100">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_0%,#dbeafe,transparent_40%),radial-gradient(circle_at_90%_20%,#e0f2fe,transparent_34%)]"></div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 lg:grid-cols-[1.15fr_0.85fr] lg:px-6 lg:py-24">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.18em] text-brand-600">Publication and research company</p>
        <h1 class="mt-4 font-serif text-4xl leading-tight tracking-tight text-slate-900 sm:text-6xl">
          Research that is written to be read, taught, and reused.
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">
          Scientific Researchers publishes biomedical AI, visual science, and cancer papers; runs AI/STEAM community programs; hosts professional development; and administers research awards. Abstracts stay open. Full project PDFs are sold individually or by subscription.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn btn-primary" href="/projects">Browse projects</a>
          <a class="btn btn-secondary" href="#pricing">View pricing</a>
          <a class="btn btn-ghost" href="/contact">Contact the office</a>
        </div>
      </div>
      <div class="card overflow-hidden p-8">
        <img src="/logo.png" alt="Scientific Researchers emblem" class="mx-auto h-56 w-56 object-contain" />
        <dl class="mt-6 grid grid-cols-3 gap-3 text-center">
          <div><dt class="text-xs uppercase tracking-wide text-slate-500">Project papers</dt><dd class="font-serif text-3xl">{papers.length}</dd></div>
          <div><dt class="text-xs uppercase tracking-wide text-slate-500">Open programs</dt><dd class="font-serif text-3xl">3</dd></div>
          <div><dt class="text-xs uppercase tracking-wide text-slate-500">Awards announced</dt><dd class="font-serif text-3xl">{awards.length}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 lg:px-6">
    <h2 class="font-serif text-3xl tracking-tight">What we publish and run</h2>
    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {Object.values(categoryMeta).map((category) => (
        <a href={category.href} class="card block p-6 hover:-translate-y-0.5 hover:border-brand-200">
          <p class="text-sm font-bold text-brand-700">{category.label}</p>
          <p class="mt-3 text-sm leading-6 text-slate-600">{category.description}</p>
        </a>
      ))}
    </div>
    <div class="mt-5 grid gap-5 md:grid-cols-3">
      <a href="/community" class="card block p-6">
        <p class="text-sm font-bold text-brand-700">Community Services</p>
        <p class="mt-3 text-sm leading-6 text-slate-600">AI/STEAM programs, outreach events, and workshops that stay free to read and attend.</p>
      </a>
      <a href="/professional-development" class="card block p-6">
        <p class="text-sm font-bold text-brand-700">Professional Development</p>
        <p class="mt-3 text-sm leading-6 text-slate-600">Articles, poster presentations, webinars, and publication guidance for working researchers.</p>
      </a>
      <a href="/awards" class="card block p-6">
        <p class="text-sm font-bold text-brand-700">Awards</p>
        <p class="mt-3 text-sm leading-6 text-slate-600">Awards are listed only after one is announced. The page stays empty until then.</p>
      </a>
    </div>
  </section>

  <section class="bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-16 lg:px-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="font-serif text-3xl tracking-tight">Featured project papers</h2>
          <p class="mt-2 text-slate-600">Free abstracts on every paper page. PDFs unlock after purchase or an active subscription.</p>
        </div>
        <a class="btn btn-secondary" href="/projects">All projects</a>
      </div>
      <div class="mt-8 grid gap-5 md:grid-cols-2">
        {papers.slice(0, 4).map((paper) => (
          <a href={`/projects/${paper.category}/${paper.slug}`} class="card block p-6">
            <p class="text-xs font-bold uppercase tracking-wide text-brand-600">{paper.categoryLabel}</p>
            <h3 class="mt-2 font-serif text-2xl">{paper.title}</h3>
            <p class="mt-2 line-clamp-3 text-sm leading-6 text-slate-600">{paper.abstract}</p>
            <p class="mt-4 text-sm font-semibold text-brand-700">Read abstract · ${paper.price}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <PricingCards />
</BaseLayout>
