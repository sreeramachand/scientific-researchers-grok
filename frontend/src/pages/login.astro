---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Login" description="Sign in to Scientific Researchers with email and password or Google.">
  <section class="mx-auto max-w-md px-4 py-16">
    <h1 class="font-serif text-4xl">Login</h1>
    <p class="mt-2 text-slate-600">Use the same email you registered, or continue with Google.</p>
    <form id="login-form" class="card mt-8 grid gap-4 p-6">
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="field">
        <div class="flex items-center justify-between gap-3">
          <label for="password">Password</label>
          <a class="text-sm font-semibold text-brand-700" href="/forgot-password">Forgot password?</a>
        </div>
        <input id="password" name="password" type="password" autocomplete="current-password" required minlength="8" />
      </div>
      <button class="btn btn-primary" type="submit">Login</button>
      <button id="google-btn" class="btn btn-secondary" type="button">Continue with Google</button>
      <p id="auth-status" class="text-sm text-slate-600" role="status"></p>
      <p id="auth-error" class="text-sm text-red-600" role="alert"></p>
      <p class="text-sm text-slate-600">Need an account? <a id="signup-link" class="font-semibold text-brand-700" href="/signup">Sign Up</a></p>
    </form>
  </section>
</BaseLayout>

<script>
  import { getSession, signIn, signInWithGoogle } from "../lib/auth";
  import { safeNextPath } from "../lib/return-path";

  const params = new URLSearchParams(window.location.search);
  const next = safeNextPath(params.get("next"));
  const error = document.getElementById("auth-error");
  const status = document.getElementById("auth-status");
  const signup = document.getElementById("signup-link");
  if (signup instanceof HTMLAnchorElement) {
    signup.href = `/signup?next=${encodeURIComponent(next)}`;
  }
  if (params.get("reset") === "1" && status) {
    status.textContent = "Password updated. Sign in with your new password.";
  }

  void getSession().then((user) => {
    if (user) window.location.replace(next);
  });

  document.getElementById("login-form")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const form = event.target as HTMLFormElement;
    const data = new FormData(form);
    try {
      await signIn({
        email: String(data.get("email") ?? ""),
        password: String(data.get("password") ?? ""),
      });
      window.location.assign(next);
    } catch (err) {
      if (error) error.textContent = err instanceof Error ? err.message : "Could not sign in.";
    }
  });

  document.getElementById("google-btn")?.addEventListener("click", async () => {
    try {
      const providerUrl = await signInWithGoogle(next);
      // Neon returns the Google start URL. Open that, then come back to next.
      window.location.assign(providerUrl ?? next);
    } catch (err) {
      if (error) error.textContent = err instanceof Error ? err.message : "Google sign-in failed.";
    }
  });
</script>
