---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Forgot password" description="Reset the password for your Scientific Researchers email account.">
  <section class="mx-auto max-w-md px-4 py-16">
    <h1 class="font-serif text-4xl">Forgot password</h1>
    <p class="mt-2 text-slate-600">
      Email and password accounts can reset here. If you signed in with Google, continue with Google instead.
    </p>
    <form id="reset-request-form" class="card mt-8 grid gap-4 p-6">
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
      </div>
      <button class="btn btn-primary" type="submit">Send reset link</button>
      <button id="google-btn" class="btn btn-secondary" type="button">Continue with Google</button>
      <p id="auth-status" class="text-sm text-slate-600" role="status"></p>
      <p id="auth-error" class="text-sm text-red-600" role="alert"></p>
      <p class="text-sm text-slate-600">
        Remembered it? <a class="font-semibold text-brand-700" href="/login">Login</a>
      </p>
    </form>
  </section>
</BaseLayout>

<script>
  import { isGoogleOnlyAccountError, requestPasswordReset, signInWithGoogle } from "../lib/auth";

  const status = document.getElementById("auth-status");
  const error = document.getElementById("auth-error");

  document.getElementById("reset-request-form")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (error) error.textContent = "";
    if (status) status.textContent = "";
    const data = new FormData(event.target as HTMLFormElement);
    try {
      await requestPasswordReset(String(data.get("email") ?? ""));
      if (status) {
        status.textContent =
          "If an email and password account exists for that address, we sent a reset link. It expires in 15 minutes.";
      }
    } catch (err) {
      const message = isGoogleOnlyAccountError(err)
        ? err.message
        : err instanceof Error
          ? err.message
          : "Could not send a reset link.";
      if (error) error.textContent = message;
    }
  });

  document.getElementById("google-btn")?.addEventListener("click", async () => {
    if (error) error.textContent = "";
    try {
      const providerUrl = await signInWithGoogle();
      window.location.assign(providerUrl ?? "/dashboard");
    } catch (err) {
      if (error) error.textContent = err instanceof Error ? err.message : "Google sign-in failed.";
    }
  });
</script>
