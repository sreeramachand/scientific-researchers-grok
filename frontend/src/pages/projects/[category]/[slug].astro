---
import PaperView from "../../../components/PaperView.astro";
import PlaceholderStudyView from "../../../components/PlaceholderStudyView.astro";
import { placeholderStudies, type PlaceholderStudy } from "../../../data/placeholder-studies";
import { papers, type Paper } from "../../../data/papers";

export function getStaticPaths() {
  const published = papers.map((paper) => ({
    params: { category: paper.category, slug: paper.slug },
    props: { paper, study: null as PlaceholderStudy | null },
  }));
  const placeholders = placeholderStudies.map((study) => ({
    params: { category: study.category, slug: study.slug },
    props: { paper: null as Paper | null, study },
  }));
  return [...published, ...placeholders];
}

const { paper, study } = Astro.props;
---

{paper ? <PaperView paper={paper} /> : study ? <PlaceholderStudyView study={study} /> : null}
