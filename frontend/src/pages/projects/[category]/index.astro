---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import {
  categoryMeta,
  categorySlugs,
  papersByCategory,
  type PaperCategory,
} from "../../../data/papers";

export function getStaticPaths() {
  return categorySlugs.map((category) => ({ params: { category } }));
}

const category = Astro.params.category as PaperCategory;
const meta = categoryMeta[category];
const items = papersByCategory(category);
---

<BaseLayout title={meta.label} description={meta.description}>
  <PageHero kicker="Projects" title={meta.label} lede={meta.description} />
  <section class="mx-auto grid max-w-6xl gap-5 px-4 py-12 lg:px-6">
    {items.length === 0 ? (
      <p class="text-slate-600">No published papers in this area yet.</p>
    ) : null}
    {items.map((paper) => (
      <a href={`/projects/${paper.category}/${paper.slug}`} class="card block p-6">
        <h2 class="font-serif text-2xl">{paper.title}</h2>
        <p class="mt-2 text-sm text-slate-500">{paper.authors}{paper.year ? ` · ${paper.year}` : ""}</p>
        <p class="mt-3 text-slate-600">{paper.abstract}</p>
        <p class="mt-4 text-sm font-semibold text-brand-700">Open abstract · ${paper.price}</p>
      </a>
    ))}
  </section>
</BaseLayout>
