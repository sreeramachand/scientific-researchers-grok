---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { categoryMeta, papers } from "../../data/papers";
---

<BaseLayout title="Projects" description="Paywalled research papers in biomedical AI, visual science, and cancer. Abstracts are free.">
  <PageHero
    kicker="Projects"
    title="The research catalog"
    lede="Project papers are the only paywalled content on this site. Read every abstract at no cost. Purchase a PDF or keep an active subscription to open the file."
  />
  <section class="mx-auto max-w-6xl px-4 py-12 lg:px-6">
    <div class="grid gap-5 md:grid-cols-3">
      {Object.entries(categoryMeta).map(([key, meta]) => (
        <a href={meta.href} class="card p-6">
          <h2 class="font-serif text-2xl">{meta.label}</h2>
          <p class="mt-3 text-sm leading-6 text-slate-600">{meta.description}</p>
          <p class="mt-4 text-sm font-semibold text-brand-700">{papers.filter((paper) => paper.category === key).length} papers</p>
        </a>
      ))}
    </div>
    <div class="mt-10 grid gap-5">
      {papers.map((paper) => (
        <a href={`/projects/${paper.category}/${paper.slug}`} class="card block p-6">
          <p class="text-xs font-bold uppercase tracking-wide text-brand-600">{paper.categoryLabel}</p>
          <h2 class="mt-1 font-serif text-2xl">{paper.title}</h2>
          <p class="mt-2 line-clamp-2 text-sm text-slate-600">{paper.abstract}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
