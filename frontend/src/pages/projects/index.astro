---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { categoryMeta, papers } from "../../data/papers";
---

<BaseLayout title="Projects" description="Search published papers by title, authors, abstract, or keywords.">
  <PageHero
    kicker="Projects"
    title="The research catalog"
    lede="Search the published paper database by title, authors, abstract, or keywords. The catalog starts with the glioblastoma paper."
  />
  <section class="mx-auto max-w-6xl px-4 py-12 lg:px-6">
    <div class="grid gap-5 md:grid-cols-3">
      {Object.entries(categoryMeta).map(([key, meta]) => {
        const count = papers.filter((paper) => paper.category === key && paper.published !== false).length;
        return (
          <a href={meta.href} class="card p-6">
            <h2 class="font-serif text-2xl">{meta.label}</h2>
            <p class="mt-3 text-sm leading-6 text-slate-600">{meta.description}</p>
            <p class="mt-4 text-sm font-semibold text-brand-700">
              {count === 0 ? "No published papers" : `${count} published`}
            </p>
          </a>
        );
      })}
    </div>

    <form id="paper-search-form" class="mt-10" role="search">
      <label class="field">
        <span class="text-sm font-semibold">Search published papers</span>
        <input
          id="paper-search"
          name="q"
          type="search"
          placeholder="Title, authors, abstract, or keyword"
          autocomplete="off"
        />
      </label>
    </form>
    <p id="paper-none" class="mt-4 hidden text-sm text-slate-600" role="status">No published papers match that search.</p>
    <div id="paper-results" class="mt-4 grid gap-5">
      {papers.filter((paper) => paper.published !== false).map((paper) => (
        <a href={`/projects/${paper.category}/${paper.slug}`} class="card block p-6" data-paper={paper.slug}>
          <p class="text-xs font-bold uppercase tracking-wide text-brand-600">{paper.categoryLabel}</p>
          <h2 class="mt-1 font-serif text-2xl">{paper.title}</h2>
          <p class="mt-2 text-sm text-slate-500">{paper.authors}</p>
          <p class="mt-2 line-clamp-2 text-sm text-slate-600">{paper.abstract}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  import { papers } from "../../data/papers";
  import { searchPapers } from "../../lib/paper-search";

  const input = document.getElementById("paper-search") as HTMLInputElement | null;
  const none = document.getElementById("paper-none");
  const cards = document.querySelectorAll<HTMLElement>("[data-paper]");

  function applySearch(query: string) {
    const matches = new Set(searchPapers(papers, query).map((paper) => paper.slug));
    cards.forEach((card) => card.classList.toggle("hidden", !matches.has(card.dataset.paper ?? "")));
    const showEmpty = query.trim().length > 0 && matches.size === 0;
    none?.classList.toggle("hidden", !showEmpty);
  }

  input?.addEventListener("input", () => applySearch(input.value));
  document.getElementById("paper-search-form")?.addEventListener("submit", (event) => {
    event.preventDefault();
    applySearch(input?.value ?? "");
  });
</script>
