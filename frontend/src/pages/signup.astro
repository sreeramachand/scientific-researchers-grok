---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Sign Up" description="Create a Scientific Researchers account with email and password or Google.">
  <section class="mx-auto max-w-md px-4 py-16">
    <h1 class="font-serif text-4xl">Sign Up</h1>
    <p class="mt-2 text-slate-600">Create an account to manage purchases, subscriptions, and award activity.</p>
    <form id="signup-form" class="card mt-8 grid gap-4 p-6">
      <div class="field">
        <label for="name">Full name</label>
        <input id="name" name="name" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="username">Username</label>
        <input id="username" name="username" autocomplete="username" required />
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="new-password" required minlength="8" />
      </div>
      <button class="btn btn-primary" type="submit">Create account</button>
      <button id="google-btn" class="btn btn-secondary" type="button">Continue with Google</button>
      <p id="auth-error" class="text-sm text-red-600" role="alert"></p>
      <p class="text-sm text-slate-600">Already registered? <a class="font-semibold text-brand-700" href="/login">Login</a></p>
    </form>
  </section>
</BaseLayout>

<script>
  import { getSession, signInWithGoogle, signUp } from "../lib/auth";
  import { googleCallbackErrorMessage } from "../lib/google-callback";
  import { safeNextPath } from "../lib/return-path";

  const params = new URLSearchParams(window.location.search);
  const next = safeNextPath(params.get("next"));
  const error = document.getElementById("auth-error");
  const googleError = googleCallbackErrorMessage(params.get("error"));
  const login = document.querySelector('a[href="/login"]');
  if (login instanceof HTMLAnchorElement) {
    login.href = `/login?next=${encodeURIComponent(next)}`;
  }

  if (googleError && error) error.textContent = googleError;

  void getSession().then((user) => {
    if (user && !googleError) window.location.replace(next);
  });

  document.getElementById("signup-form")?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const data = new FormData(event.target as HTMLFormElement);
    try {
      await signUp({
        name: String(data.get("name") ?? ""),
        username: String(data.get("username") ?? ""),
        email: String(data.get("email") ?? ""),
        password: String(data.get("password") ?? ""),
      });
      window.location.assign(next);
    } catch (err) {
      if (error) error.textContent = err instanceof Error ? err.message : "Could not create the account.";
    }
  });

  document.getElementById("google-btn")?.addEventListener("click", async () => {
    try {
      const providerUrl = await signInWithGoogle(next, "signup");
      window.location.assign(providerUrl ?? next);
    } catch (err) {
      if (error) error.textContent = err instanceof Error ? err.message : "Google sign-in failed.";
    }
  });
</script>
