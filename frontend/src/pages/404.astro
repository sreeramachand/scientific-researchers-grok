---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="That address is not in the Scientific Researchers catalog.">
  <section class="mx-auto max-w-xl px-4 py-24 text-center">
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand-600">404</p>
    <h1 class="mt-3 font-serif text-4xl">This page is not in the catalog</h1>
    <p class="mt-3 text-slate-600">Check the Projects list, or return to the public programs.</p>
    <div class="mt-8 flex justify-center gap-3">
      <a class="btn btn-primary" href="/">Home</a>
      <a class="btn btn-secondary" href="/projects">Projects</a>
    </div>
  </section>
</BaseLayout>
