---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { awards } from "../data/awards";
---

<BaseLayout title="Awards" description="Awards appear here only after one has been announced.">
  <PageHero
    kicker="Awards"
    title="Awards"
    lede="This page stays empty until a real award exists."
  />
  <section class="mx-auto max-w-3xl px-4 py-12 lg:px-6">
    {awards.length === 0 ? (
      <p id="awards-empty" class="text-slate-600">No awards have been announced.</p>
    ) : (
      <ul class="space-y-4">
        {awards.map((award) => (
          <li class="card p-6">
            <p class="text-sm font-semibold text-brand-700">{award.year}</p>
            <h2 class="mt-1 font-serif text-2xl">{award.title}</h2>
            <p class="mt-2 font-semibold">{award.recipient}</p>
            <p class="mt-2 text-slate-600">{award.summary}</p>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
