---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { informationSessions, monthGrid, sessionOn } from "../../lib/sessions";

const months = [
  { year: 2026, month: 11, label: "November 2026" },
  { year: 2026, month: 12, label: "December 2026" },
  { year: 2027, month: 1, label: "January 2027" },
];
const weekdays = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
---

<BaseLayout
  title="Webinars"
  description="Information sessions on three Friday evenings. A message of interest is required before the meeting link is shown."
>
  <PageHero
    kicker="Professional Development"
    title="Webinars"
    lede="Information sessions run 7:00–8:00 PM ET on the Fridays marked below. The Google Meet link is not open access. Joining requires a message of interest, and that message is mandatory."
  />
  <section class="mx-auto max-w-6xl px-4 py-12 lg:px-6">
    <div class="grid gap-6 lg:grid-cols-3">
      {months.map((month) => (
        <div class="card p-4">
          <h2 class="font-serif text-2xl">{month.label}</h2>
          <div class="mt-4 grid grid-cols-7 gap-1 text-center text-xs font-semibold text-slate-500">
            {weekdays.map((day) => <div>{day}</div>)}
          </div>
          <div class="mt-2 grid grid-cols-7 gap-1">
            {monthGrid(month.year, month.month).map((cell) => {
              const session = cell.date ? sessionOn(cell.date) : undefined;
              if (!cell.inMonth) return <div class="h-10"></div>;
              if (!session) {
                return <div class="grid h-10 place-items-center text-sm text-slate-400">{Number(cell.date.slice(-2))}</div>;
              }
              return (
                <button
                  type="button"
                  class="session-day grid h-10 place-items-center rounded-lg bg-brand-600 text-sm font-semibold text-white"
                  data-session={session.id}
                  id={`session-${session.id}`}
                  aria-label={`${session.label}, information session, ${session.time}`}
                >
                  {Number(cell.date.slice(-2))}
                </button>
              );
            })}
          </div>
        </div>
      ))}
    </div>

    <p class="mt-6 text-sm text-slate-600">
      Only these days have meetings, each {informationSessions[0].time}:
      {informationSessions.map((session) => session.label).join("; ")}.
    </p>

    <form id="rsvp-form" class="card mt-8 hidden max-w-xl p-6" hidden>
      <h2 id="rsvp-heading" class="font-serif text-2xl">Message of interest</h2>
      <p class="mt-2 text-sm text-slate-600">Name, email, and a message are required. The Meet link appears after this RSVP is saved.</p>
      <input type="hidden" id="rsvp-session" name="session_id" />
      <label class="field mt-4">
        <span>Name</span>
        <input id="rsvp-name" name="name" required autocomplete="name" />
      </label>
      <label class="field mt-4">
        <span>Email</span>
        <input id="rsvp-email" name="email" type="email" required autocomplete="email" />
      </label>
      <label class="field mt-4">
        <span>Message of interest</span>
        <textarea id="rsvp-message" name="message" rows="5" required></textarea>
      </label>
      <button class="btn btn-primary mt-4" type="submit">Send message of interest</button>
      <p id="rsvp-status" class="mt-3 text-sm text-slate-600" role="status"></p>
      <p id="rsvp-link" class="mt-3 hidden text-sm"></p>
    </form>

    <section id="rsvp-admin" class="mt-10 hidden" hidden>
      <h2 class="font-serif text-2xl">RSVPs</h2>
      <p id="rsvp-admin-note" class="mt-2 text-sm text-slate-600"></p>
      <ul id="rsvp-admin-list" class="mt-4 space-y-3"></ul>
    </section>
  </section>
</BaseLayout>

<script>
  import { apiFetch } from "../../lib/api";
  import { getSession, readSession } from "../../lib/auth";
  import { env } from "../../lib/env";
  import { isReviewer } from "../../lib/reviewers";
  import { informationSessions } from "../../lib/sessions";

  const form = document.getElementById("rsvp-form");
  const sessionInput = document.getElementById("rsvp-session") as HTMLInputElement | null;
  const heading = document.getElementById("rsvp-heading");
  const status = document.getElementById("rsvp-status");
  const link = document.getElementById("rsvp-link");

  function clearLink() {
    if (!link) return;
    link.textContent = "";
    link.classList.add("hidden");
  }

  document.querySelectorAll<HTMLButtonElement>(".session-day").forEach((button) => {
    button.addEventListener("click", () => {
      const id = button.dataset.session ?? "";
      const session = informationSessions.find((item) => item.id === id);
      if (!session || !form || !sessionInput) return;
      sessionInput.value = session.id;
      if (heading) heading.textContent = `${session.label} · ${session.time}`;
      form.classList.remove("hidden");
      form.removeAttribute("hidden");
      clearLink();
      if (status) status.textContent = "";
      document.getElementById("rsvp-message")?.focus();
    });
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const name = (document.getElementById("rsvp-name") as HTMLInputElement).value.trim();
    const email = (document.getElementById("rsvp-email") as HTMLInputElement).value.trim();
    const message = (document.getElementById("rsvp-message") as HTMLTextAreaElement).value.trim();
    const sessionId = sessionInput?.value ?? "";
    if (!name || !email || !message || !sessionId) {
      if (status) status.textContent = "Name, email, and a message of interest are required.";
      clearLink();
      return;
    }
    if (status) status.textContent = "Saving…";
    clearLink();
    try {
      const response = await fetch(`${env.apiUrl.replace(/\/$/, "")}/api/webinars/rsvp/`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ session_id: sessionId, name, email, message }),
      });
      const payload = (await response.json().catch(() => ({}))) as {
        detail?: string;
        meet_url?: string;
        notification_sent?: boolean;
        notification_error?: string;
      };
      if (!response.ok || !payload.meet_url) {
        if (status) status.textContent = payload.detail ?? "The RSVP was not saved, and no meeting link was issued.";
        return;
      }
      const mail = payload.notification_sent
        ? "The office was notified."
        : payload.notification_error || "The office email notice was not sent.";
      if (status) status.textContent = `RSVP saved. ${mail}`;
      if (link) {
        link.classList.remove("hidden");
        const anchor = document.createElement("a");
        anchor.href = payload.meet_url;
        anchor.textContent = "Open the Google Meet for this session";
        anchor.className = "font-semibold text-brand-700";
        anchor.rel = "noopener noreferrer";
        anchor.target = "_blank";
        link.replaceChildren(document.createTextNode("Meeting link: "), anchor);
      }
    } catch {
      if (status) status.textContent = "The RSVP was not saved. Check that the API is reachable and try again.";
    }
  });

  const user = (await getSession()) ?? readSession();
  const admin = document.getElementById("rsvp-admin");
  if (user && isReviewer(user.email) && admin) {
    admin.classList.remove("hidden");
    admin.removeAttribute("hidden");
    const note = document.getElementById("rsvp-admin-note");
    const list = document.getElementById("rsvp-admin-list");
    const response = await apiFetch("/api/webinars/rsvps/");
    if (!response.ok) {
      if (note) note.textContent = "We could not confirm this account, so the RSVP list stays hidden.";
    } else {
      const rows = (await response.json()) as {
        name: string;
        email: string;
        message: string;
        session_id: string;
        notification_sent: boolean;
        notification_error: string;
      }[];
      if (note) note.textContent = rows.length ? `${rows.length} saved.` : "No RSVPs yet.";
      for (const row of rows) {
        const item = document.createElement("li");
        item.className = "rounded-xl border border-slate-200 p-4";
        const who = document.createElement("p");
        who.className = "font-semibold";
        who.textContent = `${row.name} · ${row.email}`;
        const session = document.createElement("p");
        session.className = "text-sm text-slate-600";
        session.textContent = informationSessions.find((item) => item.id === row.session_id)?.label ?? row.session_id;
        const message = document.createElement("p");
        message.className = "mt-2 text-sm text-slate-700";
        message.textContent = row.message;
        const mail = document.createElement("p");
        mail.className = "mt-2 text-sm text-slate-500";
        mail.textContent = row.notification_sent ? "Email notice sent." : row.notification_error || "Email notice was not sent.";
        item.append(who, session, message, mail);
        list?.append(item);
      }
    }
  }
</script>
