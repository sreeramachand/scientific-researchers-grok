---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { posterConferences } from "../../data/conferences";
import { professionalPages } from "../../data/programs";

export function getStaticPaths() {
  return professionalPages
    .filter((page) => page.slug !== "webinars")
    .map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
---

<BaseLayout title={page.title} description={page.lede}>
  <PageHero kicker={page.kicker} title={page.title} lede={page.lede} />
  <div class="mx-auto max-w-3xl px-4 py-12 prose-sr lg:px-6">
    {page.sections.map((section) => (
      <section>
        <h2>{section.title}</h2>
        <p>{section.body}</p>
        {section.items && (
          <ul>
            {section.items.map((item) => <li>{item}</li>)}
          </ul>
        )}
      </section>
    ))}
    {page.slug === "poster-presentations" && (
      <section>
        <h2>Conferences with poster sessions</h2>
        <p>
          These meetings are active, hold poster sessions at least once a year, and accept bioinformatics papers.
          Each link is the conference’s own page.
        </p>
        <ul class="mt-4 space-y-4">
          {posterConferences.map((conference) => (
            <li>
              <a class="font-semibold text-brand-700" href={conference.href}>{conference.name}</a>
              <span class="text-slate-500"> · {conference.region}</span>
              <p>{conference.detail}</p>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>
