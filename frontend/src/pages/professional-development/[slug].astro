---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { professionalPages } from "../../data/programs";

export function getStaticPaths() {
  return professionalPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
---

<BaseLayout title={page.title} description={page.lede}>
  <PageHero kicker={page.kicker} title={page.title} lede={page.lede} />
  <div class="mx-auto max-w-3xl px-4 py-12 prose-sr lg:px-6">
    {page.sections.map((section) => (
      <section>
        <h2>{section.title}</h2>
        <p>{section.body}</p>
        {section.items && (
          <ul>
            {section.items.map((item) => <li>{item}</li>)}
          </ul>
        )}
      </section>
    ))}
  </div>
</BaseLayout>
