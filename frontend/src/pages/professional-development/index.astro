---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { professionalPages } from "../../data/programs";
---

<BaseLayout title="Professional Development" description="Open articles, posters, webinars, and publication guidance.">
  <PageHero
    kicker="Professional Development"
    title="Practice for people who write, present, and review"
    lede="Articles, poster presentations, webinars, and publication policy stay open. They sit beside the project catalog; they do not unlock PDFs."
  />
  <section class="mx-auto grid max-w-6xl gap-5 px-4 py-12 md:grid-cols-2 lg:px-6">
    {professionalPages.map((page) => (
      <a href={`/professional-development/${page.slug}`} class="card p-6">
        <h2 class="font-serif text-2xl">{page.title}</h2>
        <p class="mt-3 text-sm leading-6 text-slate-600">{page.lede}</p>
      </a>
    ))}
  </section>
</BaseLayout>
