---
type Props = {
  kicker?: string;
  title: string;
  lede: string;
};

const { kicker, title, lede } = Astro.props;
---

<section class="border-b border-slate-100 bg-[radial-gradient(circle_at_top_right,#dbeafe,transparent_42%),linear-gradient(#ffffff,#f8fafc)]">
  <div class="mx-auto max-w-6xl px-4 py-14 lg:px-6 lg:py-20">
    {kicker && <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand-600">{kicker}</p>}
    <h1 class="mt-3 max-w-3xl font-serif text-4xl tracking-tight text-slate-900 sm:text-5xl">{title}</h1>
    <p class="mt-4 max-w-2xl text-lg leading-8 text-slate-600">{lede}</p>
    <slot />
  </div>
</section>
