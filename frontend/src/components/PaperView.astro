---
import type { Paper } from "../data/papers";
import { categoryMeta } from "../data/papers";
import { env } from "../lib/env";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

type Props = { paper: Paper };
const { paper } = Astro.props;
const category = categoryMeta[paper.category];
const productUrl = new URL(
  `/projects/${paper.category}/${paper.slug}/`,
  Astro.site ?? site.url,
).href;
const byline = [paper.authors, paper.year ? String(paper.year) : "", paper.doi ? `DOI ${paper.doi}` : ""]
  .filter(Boolean)
  .join(" · ");
---

<BaseLayout title={paper.title} description={paper.abstract} includeSnipcart={Boolean(env.snipcartKey)}>
  <article class="mx-auto max-w-6xl px-4 py-10 lg:px-6">
    <p class="text-sm font-semibold text-brand-700">
      <a href="/projects">Projects</a>
      <span class="text-slate-400"> / </span>
      <a href={category.href}>{category.label}</a>
    </p>
    <h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">{paper.title}</h1>
    <p class="mt-3 text-lg text-slate-600">{paper.subtitle}</p>
    <p class="mt-4 text-sm text-slate-500">{byline}</p>

    <div class="mt-8 grid gap-8 lg:grid-cols-[1.4fr_0.8fr]">
      <div class="prose-sr">
        <h2>Abstract</h2>
        <p>{paper.abstract}</p>
        <h2>Highlights</h2>
        <ul>
          {paper.highlights.map((item) => <li>{item}</li>)}
        </ul>
        <h2>Methods summary</h2>
        <p>{paper.methods}</p>
      </div>
      <aside class="card h-fit p-6">
        <p class="text-sm font-bold uppercase tracking-wide text-slate-500">Full paper</p>
        <p class="mt-2 font-serif text-3xl">${paper.price}</p>
        <p class="mt-2 text-sm text-slate-600">One-time purchase of this PDF, or access with an active Researcher or Lab subscription.</p>
        {env.snipcartKey ? (
          <button
            type="button"
            class="btn btn-primary snipcart-add-item mt-5 w-full"
            data-item-id={paper.sku}
            data-item-price={paper.price}
            data-item-url={productUrl}
            data-item-name={paper.title}
            data-item-description={paper.subtitle}
            data-item-max-quantity="1"
            data-paper-sku={paper.sku}
          >
            Purchase PDF
          </button>
        ) : (
          <a class="btn btn-primary mt-5 w-full" href="/contact">Ask about this PDF</a>
        )}
        <a class="btn btn-secondary mt-3 w-full" href="/#pricing">See subscriptions</a>
      </aside>
    </div>

    <section class="mt-12">
      <h2 class="font-serif text-2xl">PDF</h2>
      <div
        id="paywall"
        class="relative mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-slate-50"
        data-sku={paper.sku}
        data-src={paper.pdfPath}
        data-preview={paper.previewPath ?? ""}
      >
        <div id="preview-layer">
          {paper.previewPath ? (
            <div>
              <iframe
                id="preview-frame"
                title={`First page of ${paper.title}`}
                class="h-[70vh] w-full bg-white"
                src={paper.previewPath}
              ></iframe>
              <p class="border-t border-slate-200 bg-white px-4 py-3 text-sm text-slate-600">
                First page. The rest of the paper opens after purchase.
              </p>
            </div>
          ) : (
            <div id="locked-layer" class="grid min-h-[24rem] place-items-center bg-white/80 p-6 text-center">
              <div class="max-w-md">
                <p class="font-serif text-2xl">This PDF is locked</p>
                <p class="mt-2 text-slate-600">The abstract above is free. Purchase this paper or keep an active subscription to open the file.</p>
                {env.snipcartKey ? (
                  <button type="button" class="btn btn-primary mt-5" id="unlock-cta">Unlock this paper</button>
                ) : (
                  <a class="btn btn-primary mt-5" href="/contact">Ask about access</a>
                )}
              </div>
            </div>
          )}
        </div>
        <iframe id="pdf-frame" title={`${paper.title} PDF`} class="hidden h-[70vh] w-full bg-white" src=""></iframe>
      </div>
    </section>
  </article>
</BaseLayout>

<script>
  import { papers } from "../data/papers";
  import { grantPaper, hasAccess } from "../lib/entitlements";

  const root = document.getElementById("paywall");
  const frame = document.getElementById("pdf-frame") as HTMLIFrameElement | null;
  const preview = document.getElementById("preview-layer");
  const sku = root?.dataset.sku ?? "";
  const src = root?.dataset.src ?? "";
  const key = (import.meta.env.PUBLIC_SNIPCART_API_KEY as string | undefined)?.trim();
  const known = new Set(papers.map((paper) => paper.sku));

  function orderItemIds(payload: unknown): string[] {
    if (!payload || typeof payload !== "object") return [];
    const record = payload as { items?: unknown; cart?: { items?: unknown } };
    const items = Array.isArray(record.items)
      ? record.items
      : Array.isArray(record.cart?.items)
        ? record.cart.items
        : [];
    return items
      .map((item) => {
        if (!item || typeof item !== "object") return "";
        const row = item as { id?: unknown; productId?: unknown };
        return String(row.id ?? row.productId ?? "");
      })
      .filter((id) => known.has(id));
  }

  function reveal() {
    if (!hasAccess(sku) || !frame) return;
    frame.src = src;
    frame.classList.remove("hidden");
    preview?.classList.add("hidden");
  }

  function grantConfirmed(payload: unknown) {
    for (const id of orderItemIds(payload)) grantPaper(id);
    reveal();
  }

  type SnipcartApi = {
    events: {
      on: (name: string, fn: (payload: unknown) => void) => void;
    };
  };

  let snipcartBound = false;

  function bindSnipcart() {
    if (snipcartBound) return;
    const snipcart = (window as Window & { Snipcart?: SnipcartApi }).Snipcart;
    if (!snipcart || snipcart.events == null) return;
    snipcart.events.on("cart.confirmed", grantConfirmed);
    snipcartBound = true;
  }

  if (key) {
    document.getElementById("unlock-cta")?.addEventListener("click", () => {
      document.querySelector<HTMLButtonElement>(`.snipcart-add-item[data-paper-sku="${sku}"]`)?.click();
    });
    document.addEventListener("snipcart.ready", bindSnipcart);
    bindSnipcart();
  }

  document.addEventListener("sr-entitlements-changed", reveal);
  reveal();
</script>
