---
import type { Paper } from "../data/papers";
import { categoryMeta } from "../data/papers";
import { env } from "../lib/env";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

type Props = { paper: Paper };
const { paper } = Astro.props;
const category = categoryMeta[paper.category];
const productUrl = new URL(
  `/projects/${paper.category}/${paper.slug}/`,
  Astro.site ?? site.url,
).href;
const byline = [paper.authors, paper.year ? String(paper.year) : "", paper.doi ? `DOI ${paper.doi}` : ""]
  .filter(Boolean)
  .join(" · ");
---

<BaseLayout title={paper.title} description={paper.abstract} includeSnipcart={Boolean(env.snipcartKey)}>
  <article class="mx-auto max-w-6xl px-4 py-10 lg:px-6">
    <p class="text-sm font-semibold text-brand-700">
      <a href="/projects">Projects</a>
      <span class="text-slate-400"> / </span>
      <a href={category.href}>{category.label}</a>
    </p>
    <h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">{paper.title}</h1>
    <p class="mt-3 text-lg text-slate-600">{paper.subtitle}</p>
    <p class="mt-4 text-sm text-slate-500">{byline}</p>

    <div class="mt-8 grid gap-8 lg:grid-cols-[1.4fr_0.8fr]">
      <div class="prose-sr">
        <h2>Abstract</h2>
        <p>{paper.abstract}</p>
        <h2>Highlights</h2>
        <ul>
          {paper.highlights.map((item) => <li>{item}</li>)}
        </ul>
        <h2>Methods summary</h2>
        <p>{paper.methods}</p>
      </div>
      <aside class="card h-fit p-6">
        <p class="text-sm font-bold uppercase tracking-wide text-slate-500">Full paper</p>
        <p class="mt-2 font-serif text-3xl">${paper.price}</p>
        <p class="mt-2 text-sm text-slate-600">One-time purchase of this PDF.</p>
        {env.snipcartKey ? (
          <button
            type="button"
            class="btn btn-primary mt-5 w-full"
            id="purchase-pdf"
            data-sku={paper.sku}
            data-price={paper.price}
            data-name={paper.title}
            data-description={paper.subtitle}
            data-product-url={productUrl}
          >
            Purchase PDF
          </button>
        ) : (
          <a class="btn btn-primary mt-5 w-full" href="/contact">Ask about this PDF</a>
        )}
        <div id="owned-actions" class="mt-5 hidden grid gap-3">
          <a id="open-pdf" class="btn btn-primary w-full" target="_blank" rel="noopener" referrerpolicy="no-referrer">Open PDF</a>
          <a id="download-pdf" class="btn btn-secondary w-full" referrerpolicy="no-referrer">Download PDF</a>
        </div>
        <p id="purchase-note" class="mt-3 text-sm text-slate-600" role="status"></p>
        <a class="btn btn-secondary mt-3 w-full" href="/#pricing">See subscriptions</a>
      </aside>
    </div>

    <section class="mt-12">
      <h2 class="font-serif text-2xl">PDF</h2>
      <div
        id="paywall"
        class="relative mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-slate-50"
        data-sku={paper.sku}
        data-title={paper.title}
      >
        <div id="preview-layer">
          {paper.previewPath ? (
            <div>
              <iframe
                id="preview-frame"
                title={`First page of ${paper.title}`}
                class="h-[70vh] w-full bg-white"
                src={paper.previewPath}
              ></iframe>
              <p class="border-t border-slate-200 bg-white px-4 py-3 text-sm text-slate-600">
                First page. The rest of the paper opens after purchase.
              </p>
            </div>
          ) : (
            <div id="locked-layer" class="grid min-h-[24rem] place-items-center bg-white/80 p-6 text-center">
              <div class="max-w-md">
                <p class="font-serif text-2xl">This PDF is locked</p>
                <p class="mt-2 text-slate-600">The abstract above is free. Purchase this paper to open the file.</p>
                {env.snipcartKey ? (
                  <button type="button" class="btn btn-primary mt-5" id="unlock-cta">Unlock this paper</button>
                ) : (
                  <a class="btn btn-primary mt-5" href="/contact">Ask about access</a>
                )}
              </div>
            </div>
          )}
        </div>
        <iframe id="pdf-frame" title={`${paper.title} PDF`} class="hidden h-[70vh] w-full bg-white" src=""></iframe>
      </div>
    </section>
  </article>
</BaseLayout>

<script>
  import { papers } from "../data/papers";
  import { getSession, readSession } from "../lib/auth";
  import { invoiceFrom, orderTokenFrom, paperSkusInOrder } from "../lib/paper-file";
  import { claimPurchase, purchaseFor, purchasedFileUrl, type StoredPurchase } from "../lib/purchases";
  import { safeNextPath } from "../lib/return-path";

  const root = document.getElementById("paywall");
  const frame = document.getElementById("pdf-frame") as HTMLIFrameElement | null;
  const preview = document.getElementById("preview-layer");
  const note = document.getElementById("purchase-note");
  const sku = root?.dataset.sku ?? "";
  const title = root?.dataset.title ?? sku;
  const key = (import.meta.env.PUBLIC_SNIPCART_API_KEY as string | undefined)?.trim();
  const known = new Set(papers.map((paper) => paper.sku));

  type CartItem = {
    id: string;
    name: string;
    price: number;
    url: string;
    description: string;
    quantity: number;
    maxQuantity: number;
  };

  type SnipcartApi = {
    api?: {
      cart?: {
        items?: {
          add?: (item: CartItem) => Promise<unknown>;
        };
      };
    };
    events?: {
      on: (name: string, fn: (payload: unknown) => void) => void;
    };
  };

  function snipcart(): SnipcartApi | undefined {
    return (window as Window & { Snipcart?: SnipcartApi }).Snipcart;
  }

  async function showOwned(purchase: StoredPurchase) {
    const open = document.getElementById("open-pdf");
    const download = document.getElementById("download-pdf");
    if (open instanceof HTMLAnchorElement) {
      open.href = purchasedFileUrl(purchase.sku, purchase.accessToken);
    }
    if (download instanceof HTMLAnchorElement) {
      download.href = purchasedFileUrl(purchase.sku, purchase.accessToken, true);
    }
    document.getElementById("owned-actions")?.classList.remove("hidden");
    document.getElementById("purchase-pdf")?.classList.add("hidden");
    document.getElementById("unlock-cta")?.classList.add("hidden");
    if (!frame) return;
    const response = await fetch(purchasedFileUrl(purchase.sku, purchase.accessToken));
    if (!response.ok) return;
    frame.src = URL.createObjectURL(await response.blob());
    frame.classList.remove("hidden");
    preview?.classList.add("hidden");
  }

  async function grantConfirmed(payload: unknown) {
    const user = readSession() ?? (await getSession());
    if (!user?.email) return;
    const orderToken = orderTokenFrom(payload);
    const skus = paperSkusInOrder(payload, known);
    if (!orderToken || skus.length === 0) {
      if (note) note.textContent = "We could not open the PDF for this purchase.";
      return;
    }
    for (const id of skus) {
      try {
        const saved = await claimPurchase({
          email: user.email,
          sku: id,
          orderToken,
          invoice: invoiceFrom(payload),
          title: id === sku ? title : undefined,
        });
        if (id === sku) await showOwned(saved);
      } catch (error) {
        if (id === sku && note) {
          note.textContent = error instanceof Error ? error.message : "We could not open the PDF for this purchase.";
        }
      }
    }
  }

  function goToSignIn() {
    const next = encodeURIComponent(safeNextPath(window.location.pathname + window.location.search, window.location.pathname));
    window.location.assign(`/login?next=${next}`);
  }

  async function purchase() {
    const user = (await getSession()) ?? readSession();
    if (!user?.email) {
      goToSignIn();
      return;
    }
    const existing = purchaseFor(user.email, sku);
    if (existing) {
      await showOwned(existing);
      return;
    }
    const button = document.getElementById("purchase-pdf");
    const items = snipcart()?.api?.cart?.items;
    if (!button || !items?.add) {
      if (note) note.textContent = "Checkout is still loading. Try again in a moment.";
      return;
    }
    await items.add({
      id: button.dataset.sku ?? sku,
      name: button.dataset.name ?? title,
      price: Number(button.dataset.price ?? "0"),
      url: button.dataset.productUrl ?? window.location.href,
      description: button.dataset.description ?? "",
      quantity: 1,
      maxQuantity: 1,
    });
  }

  let snipcartBound = false;

  function bindSnipcart() {
    if (snipcartBound) return;
    const events = snipcart()?.events;
    if (!events) return;
    events.on("cart.confirmed", (payload) => {
      void grantConfirmed(payload);
    });
    snipcartBound = true;
  }

  if (key) {
    document.getElementById("purchase-pdf")?.addEventListener("click", () => {
      void purchase();
    });
    document.getElementById("unlock-cta")?.addEventListener("click", () => {
      void purchase();
    });
    document.addEventListener("snipcart.ready", bindSnipcart);
    bindSnipcart();
  }

  const returning = readSession();
  if (returning) {
    const existing = purchaseFor(returning.email, sku);
    if (existing) void showOwned(existing);
  }
</script>
