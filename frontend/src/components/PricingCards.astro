---
import { pricing } from "../data/site";
---

<section id="pricing" class="mx-auto max-w-6xl px-4 py-16 lg:px-6">
  <div class="max-w-2xl">
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand-600">Access</p>
    <h2 class="mt-2 font-serif text-3xl tracking-tight sm:text-4xl">Read what you need. Subscribe when you want the catalog.</h2>
    <p class="mt-3 text-slate-600">
      Community Services, Professional Development, Awards, Home, and Contact stay free. Project paper PDFs are purchased on each paper page. Researcher and Lab plans are arranged with the office.
    </p>
  </div>
  <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
    {pricing.map((tier) => (
      <article class:list={["card flex flex-col p-6", tier.highlighted && "ring-2 ring-brand-500"]}>
        <p class="text-sm font-bold text-brand-700">{tier.name}</p>
        <p class="mt-3 font-serif text-4xl">
          {tier.price === 0 ? "Free" : `$${tier.price}`}
          {tier.price > 0 && <span class="text-base font-sans font-medium text-slate-500">/{tier.cadence}</span>}
        </p>
        <p class="mt-3 text-sm leading-6 text-slate-600">{tier.description}</p>
        <ul class="mt-5 flex-1 space-y-2 text-sm text-slate-700">
          {tier.features.map((feature) => <li class="flex gap-2"><span class="text-brand-600">✓</span>{feature}</li>)}
        </ul>
        <a class:list={["btn mt-6 w-full", tier.highlighted ? "btn-primary" : "btn-secondary"]} href={tier.href}>
          {tier.cta}
        </a>
      </article>
    ))}
  </div>
</section>
