# Copy to /etc/scientific-researchers/env on the VPS (mode 0640, owner root:sr).
# Never commit the real file.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=scientificresearchers.org
CORS_ALLOWED_ORIGINS=https://scientificresearchers.org
CSRF_TRUSTED_ORIGINS=https://scientificresearchers.org
BEHIND_PROXY=true

# Neon Postgres. Empty uses SQLite (not recommended on the VPS).
DATABASE_URL=

# Neon Auth + commerce (server-side). Browser keys are inlined at `astro build` time.
NEON_AUTH_BASE_URL=
SNIPCART_API_KEY=

# --- Caddy (also duplicated in /etc/scientific-researchers/caddy.env) ---
SITE_DOMAIN=scientificresearchers.org
ACME_EMAIL=admin@scientificresearchers.org
SITE_ROOT=/opt/scientific-researchers/current/www
